# Allowlist: ignore everything, then track only files I write myself.
# Claude Code adds new runtime files often; with an allowlist they never show up.
/*

!/.gitignore
!/CLAUDE.md
!/statusline-command.sh
!/skills/
!/agents/
!/commands/
!/rules/
!/hooks/
!/output-styles/

# Inside skills/: managed by other tools, not mine.
/skills/.trash/
/skills/synced/
/skills/orca-cli
/skills/orchestration

.DS_Store
